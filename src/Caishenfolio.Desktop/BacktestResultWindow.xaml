<Window x:Class="Caishenfolio.Desktop.BacktestResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回测结果 · 权益曲线"
        Height="560"
        Width="900"
        MinHeight="420"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#0B1018"
        Foreground="#F2F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBlock" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"
                   Text="回测权益曲线" />

        <Border Grid.Row="1" Background="#0E141A" CornerRadius="8" BorderBrush="#2A3542" BorderThickness="1">
            <Canvas x:Name="ChartCanvas" Background="#0E141A" ClipToBounds="True"
                    SizeChanged="ChartCanvas_OnSizeChanged" />
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,10,0,8" TextWrapping="Wrap"
                   FontFamily="Consolas" FontSize="12" />

        <!-- The part that can say "this rule does not work" -->
        <Border Grid.Row="3" x:Name="VerdictPanel" Visibility="Collapsed" CornerRadius="8"
                Padding="12,10" Margin="0,0,0,10" BorderThickness="1"
                Background="#16202B" BorderBrush="#2A3542">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Border DockPanel.Dock="Right" x:Name="VerdictBadge" CornerRadius="6" Padding="10,3">
                        <TextBlock x:Name="VerdictBadgeText" FontWeight="SemiBold" Foreground="#0B1018" />
                    </Border>
                    <TextBlock Text="样本外检验：把后 30% 的行情留出来，用前 70% 得到的规则去跑它没见过的数据"
                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="MetricsText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                           Opacity="0.9" Margin="0,0,0,6" />
                <ItemsControl x:Name="FindingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="研究/模拟结论，非投资建议。成本与涨跌停为简化模型；历史表现不代表未来。" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="导出到报告" Padding="12,6" Margin="0,0,8,0" Click="ExportReport_OnClick" />
            <Button Content="关闭" Padding="16,6" IsCancel="True" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
