<UserControl x:Class="Caishenfolio.Desktop.Wealth.FxCarryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="区间" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushFgMuted}" />
                <ComboBox x:Name="FxRangeCombo" Width="90" Margin="0,0,8,0" SelectedIndex="0"
                          AutomationProperties.Name="汇率历史区间" SelectionChanged="FxRangeCombo_OnSelectionChanged">
                    <ComboBoxItem Content="1 年" Tag="1" />
                    <ComboBoxItem Content="5 年" Tag="5" />
                    <ComboBoxItem Content="10 年" Tag="10" />
                </ComboBox>
                <Button x:Name="LoadButton" Content="刷新" Padding="14,6" Click="LoadButton_OnClick" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="汇率与利差" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" />
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushFgMuted}"
                           Text="点「刷新」查看各货币相对本位币的利差与当前汇率所处的历史位置。" />
            </StackPanel>
        </DockPanel>

        <Expander x:Name="FxExplanationExpander" Grid.Row="1" IsExpanded="False" Margin="0,0,0,6" Background="#16202B"
                  BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                  AutomationProperties.Name="换汇到底赚在哪、亏在哪">
            <Expander.Header>
                <TextBlock Text="换汇到底赚在哪、亏在哪" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" />
            </Expander.Header>
            <TextBox x:Name="FxExplanationText" Margin="12,0,12,10" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" TextWrapping="Wrap" Foreground="{StaticResource BrushFgSecondary}" FontSize="12"
                     AutomationProperties.Name="换汇盈亏说明"
                     Text="换汇的盈亏由两部分组成：利差和汇率变动。利差是确定的、慢的。持有高息货币每年多拿这个百分比。利差 +4% 意味着 100 万等值资产一年约多 4 万，前提是汇率一动不动。汇率变动是不确定的、快的。主要货币一天波动 1% 很常见，四天就能吃掉一年的利差。历史分位描述当前汇率在所选历史区间中的位置，不预测方向；若数据没有覆盖完整区间，只代表实际返回的数据。2022 至 2024 年美日利差处在几十年极值，日元照样单边贬值三成，随后套息平仓时三天回吐一年利差。所以：利差说明长期倾向，不说明什么时候该换。这一页不给换汇时点判断。" />
        </Expander>

        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" CornerRadius="10" Margin="0,0,0,6"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12">
            <DataGrid x:Name="LegGrid" Style="{StaticResource WealthGrid}" Height="230">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="货币对" Binding="{Binding Pair}" Width="110"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="当前汇率" Binding="{Binding RateText}" Width="110"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="持有方利率" Binding="{Binding BaseRateText}" Width="100"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="计价方利率" Binding="{Binding QuoteRateText}" Width="100"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTemplateColumn Width="130">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="年化利差（正数越高，持有利息越多）">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock TextWrapping="Wrap" Text="持有第一种货币相对第二种货币每年多拿或少拿的利息。正数表示继续持有第一种货币有利息优势，负数表示有利息劣势。它不告诉你什么时候该换。" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CarryText}" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CarryIsPositive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="FxCarryMillionColumn" Header="每 100 万年化利差（按当前利率）" Binding="{Binding CarryOnMillionText}" Width="210"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTemplateColumn Width="150">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="汇率位置（越低越接近低位）">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="340">
                                        <TextBlock x:Name="FxPercentileHelp" TextWrapping="Wrap" Text="只描述当前汇率在所选区间的位置。接近 0% 表示接近该区间低位，接近 100% 表示接近该区间高位。它不预测涨跌，也不表示某个区间一定适合兑换。" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PercentileText}" Margin="6,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushFgPrimary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="180">
                        <DataGridTemplateColumn.Header>
                            <TextBlock x:Name="FxRangeHeader" Text="1 年高低" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RangeText}" Margin="6,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushFgPrimary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="360">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="利率来源与日期">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock TextWrapping="Wrap" Text="利率来自哪个公开来源，以及该数据的日期。红色表示没能刷新，不能把它当成今天的利率。" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RateSourceText}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="6,4" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushFgSecondary}" />
                                            <Style.Triggers>
                                                <!-- A rate that could not be refreshed must not look current. -->
                                                <DataTrigger Binding="{Binding RatesStale}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- N2: exchange-path comparison lab. Research simulation — never writes to the ledger. -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgPanel}" CornerRadius="10"
                BorderBrush="#2B5A7A" BorderThickness="1" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="兑换路径比较" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushFgMuted}"
                               Text="回答一个问题：已持有的外币换过去更划算，还是新拿本位币直接换更划算。研究模拟，不写入账本；行情是参考价，不是银行可成交报价。" />
                </StackPanel>

                <!-- Inputs -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock Text="比较金额" VerticalAlignment="Center" Margin="0,0,4,6"
                               Foreground="{StaticResource BrushFgMuted}" />
                    <TextBox x:Name="FxAmountBox" AutomationProperties.Name="比较金额" Width="80" Padding="4" Margin="0,0,4,6" Text="100" />
                    <TextBlock x:Name="FxBaseCurrencyLabel" Text="CNY" VerticalAlignment="Center" Margin="0,0,12,6"
                               Foreground="{StaticResource BrushFgMuted}" />
                    <TextBlock Text="换成" VerticalAlignment="Center" Margin="0,0,4,6"
                               Foreground="{StaticResource BrushFgMuted}" />
                    <ComboBox x:Name="FxTargetCombo" AutomationProperties.Name="换成的目标币种" Width="70" Margin="0,0,12,6" SelectedIndex="0">
                        <ComboBoxItem Content="USD" />
                        <ComboBoxItem Content="HKD" />
                        <ComboBoxItem Content="JPY" />
                        <ComboBoxItem Content="EUR" />
                    </ComboBox>
                    <TextBlock Text="已持有" VerticalAlignment="Center" Margin="0,0,4,6"
                               Foreground="{StaticResource BrushFgMuted}" />
                    <ComboBox x:Name="FxHeldCombo" AutomationProperties.Name="已持有币种" Width="70" Margin="0,0,4,6" SelectedIndex="0" />
                    <TextBox x:Name="FxHeldAmountBox" AutomationProperties.Name="已持有金额" Width="90" Padding="4" Margin="0,0,4,6"
                             ToolTip="已持有的该币种金额（可点「按账本填入」自动带出）" />
                    <TextBlock Text="当时实付" VerticalAlignment="Center" Margin="0,0,4,6"
                               Foreground="{StaticResource BrushFgMuted}" />
                    <TextBox x:Name="FxHeldCostBox" AutomationProperties.Name="当时实付成本" Width="80" Padding="4" Margin="0,0,4,6"
                             ToolTip="当时买入这笔外币实际花了多少本位币（按回单填写）。用于计算你的真实历史成本。" />
                    <TextBlock x:Name="FxHeldCostCurrencyLabel" Text="CNY" VerticalAlignment="Center" Margin="0,0,12,6"
                               Foreground="{StaticResource BrushFgMuted}" />
                    <Button x:Name="FxPrefillButton" Content="按账本填入" Padding="8,3" Margin="0,0,12,6"
                            Click="FxPrefillButton_OnClick"
                            ToolTip="从账本的现金余额与换汇流水中带出：已持有金额、移动加权成本（多批次混合、消耗按均价释放）；来源不明的部分成本留空并说明" />
                    <Button x:Name="FxCompareButton" Content="比较兑换路径" Padding="10,3" Margin="0,0,12,6"
                            Background="#1F6B4A" BorderBrush="#2F9A6A" Click="FxCompareButton_OnClick" />
                </WrapPanel>

                <!-- Costs: one combined percentage per path. Empty = unknown (gross-only). -->
                <WrapPanel Grid.Row="2" Margin="0,0,0,4">
                    <TextBlock Text="成本%（点差+比例费+滑点合计，留空=未知，只比毛额）" VerticalAlignment="Center"
                               Margin="0,0,8,6" Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                    <TextBlock Text="已持有→目标" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="11"
                               Foreground="{StaticResource BrushFgSecondary}" />
                    <TextBox x:Name="FxHeldCostPctBox" AutomationProperties.Name="已持有换目标的比例成本" Width="56" Padding="4" Margin="0,0,10,6" />
                    <TextBlock Text="本位币直换" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="11"
                               Foreground="{StaticResource BrushFgSecondary}" />
                    <TextBox x:Name="FxNewCostPctBox" AutomationProperties.Name="本位币直换的比例成本" Width="56" Padding="4" Margin="0,0,10,6" />
                    <TextBlock Text="绕行已持有币种（每段各计一次）" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="11"
                               Foreground="{StaticResource BrushFgSecondary}" />
                    <TextBox x:Name="FxDetourCostPctBox" AutomationProperties.Name="绕行路径的比例成本" Width="56" Padding="4" Margin="0,0,10,6" />
                </WrapPanel>

                <!-- Fixed fees (recheck P1-03): tri-state like the percentages — blank =
                     unknown, 0 = confirmed none. Without an explicit fixed fee every net
                     figure is unreachable under the cost contract.
                     Own grid row (recheck-2 F-01): sharing Row 2 with the percentage panel
                     made the two inputs overlap and the later one stole hit-testing. -->
                <WrapPanel Grid.Row="3" Margin="0,0,0,4">
                    <TextBlock Text="固定费（留空=未知；填 0=确认无；净额需要比例与固定费都显式填写）" VerticalAlignment="Center"
                               Margin="0,0,8,6" Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                    <TextBlock Text="已持有→目标" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="11"
                               Foreground="{StaticResource BrushFgSecondary}" />
                    <TextBox x:Name="FxHeldFeeBox" AutomationProperties.Name="已持有换目标的固定费" Width="64" Padding="4" Margin="0,0,10,6" />
                    <TextBlock Text="本位币直换" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="11"
                               Foreground="{StaticResource BrushFgSecondary}" />
                    <TextBox x:Name="FxNewFeeBox" AutomationProperties.Name="本位币直换的固定费" Width="64" Padding="4" Margin="0,0,10,6" />
                    <TextBlock Text="绕行" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="11"
                               Foreground="{StaticResource BrushFgSecondary}" />
                    <TextBox x:Name="FxDetourFeeBox" AutomationProperties.Name="绕行路径的固定费" Width="64" Padding="4" Margin="0,0,10,6" />
                    <TextBlock Text="固定费币种" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="11"
                               Foreground="{StaticResource BrushFgSecondary}" />
                    <ComboBox x:Name="FxFeeCurrencyCombo" AutomationProperties.Name="固定费币种" Width="70" Margin="0,0,10,6" SelectedIndex="0">
                        <ComboBoxItem Content="CNY" IsSelected="True" />
                        <ComboBoxItem Content="HKD" />
                        <ComboBoxItem Content="USD" />
                        <ComboBoxItem Content="JPY" />
                    </ComboBox>
                </WrapPanel>

                <!-- Results -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#121A24" CornerRadius="8" Padding="10,8" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="已持有路径 相对优势（毛额）" FontSize="11"
                                       Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                            <TextBlock x:Name="FxAdvantageGrossText" Text="—" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#121A24" CornerRadius="8" Padding="10,8" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="已持有路径 相对优势（净额）" FontSize="11"
                                       Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                            <TextBlock x:Name="FxAdvantageNetText" Text="—" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#121A24" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="FxBreakevenCaption" Text="盈亏平衡（历史成本 vs 当前隐含价）" FontSize="11"
                                       Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                            <TextBlock x:Name="FxBreakevenText" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- WP-02: the "convert now" answer, the future critical rate, and the batches
                         the held pot is made of. Numbers only — no advice. -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#121A24" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="现在换能到手（含基准对比）" FontSize="11"
                                           Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                                <TextBlock x:Name="FxNowText" Text="—" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#121A24" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="未来临界汇率（到多少与基准打平）" FontSize="11"
                                           Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                                <TextBlock x:Name="FxCriticalText" Text="—" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#121A24" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="比较基准（名称与冻结时点）" FontSize="11"
                                           Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                                <TextBlock x:Name="FxBaselineText" Text="—" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Expander Grid.Row="2" Grid.ColumnSpan="3" x:Name="FxLotsExpander" IsExpanded="False"
                              Margin="0,26,0,8" Background="#16202B"
                              Header="我的换汇批次（按取得日先进先出，冲正的那笔不会出现）">
                        <StackPanel Margin="12,0,12,10">
                            <TextBlock x:Name="FxLotsHint" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,6"
                                       Foreground="{StaticResource BrushFgSecondary}" />
                            <DataGrid x:Name="FxLotGrid" Style="{StaticResource WealthGrid}" Height="170"
                                      IsReadOnly="True" AutomationProperties.Name="换汇批次列表">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="取得日" Binding="{Binding Date}" Width="90" />
                                    <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="60" />
                                    <DataGridTextColumn Header="付出（本段）" Binding="{Binding Paid}" Width="130" />
                                    <DataGridTextColumn Header="得到" Binding="{Binding Received}" Width="130" />
                                    <DataGridTextColumn Header="现在还剩" Binding="{Binding Remaining}" Width="130" />
                                    <DataGridTextColumn Header="剩余部分的成本" Binding="{Binding RemainingCost}" Width="150" />
                                    <DataGridTextColumn Header="原始投入（另一条链路，不混算）" Binding="{Binding Upstream}" Width="220" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <TextBlock Grid.Row="3" x:Name="FxQuoteInfoText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                               Foreground="{StaticResource BrushFgSecondary}" Grid.ColumnSpan="3" />

                    <ScrollViewer Grid.Row="4" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FxPathList" KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Padding="10,8" Margin="0,0,0,6" Background="#121A24"
                                              BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                              Focusable="True" KeyboardNavigation.IsTabStop="True"
                                              KeyboardNavigation.TabNavigation="Continue"
                                              AutomationProperties.Name="{Binding AccessibleName}"
                                              AutomationProperties.HelpText="{Binding AccessibleHelpText}">
                                        <GroupBox.Template>
                                            <ControlTemplate TargetType="GroupBox">
                                                <Border x:Name="CardBorder" CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush"
                                                                Value="{StaticResource BrushAccent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </GroupBox.Template>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="10"
                                                           Padding="6,1" VerticalAlignment="Center"
                                                           Foreground="{Binding StatusBrush}" />
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource BrushFgPrimary}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding StartingAsset}" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AmountsText}" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{StaticResource BrushFgSecondary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Formula}" FontSize="11" Margin="0,3,0,0"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource BrushFgSecondary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource BrushFgMuted}" />
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ItemsControl x:Name="NoteList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushFgMuted}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                       Foreground="{StaticResource BrushFgMuted}" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
