<UserControl x:Class="Caishenfolio.Desktop.Wealth.IpoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="刷新" Padding="14,6"
                    Click="RefreshButton_OnClick" />
            <StackPanel>
                <TextBlock Text="打新记录" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" />
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushFgMuted}"
                           Text="记录每一次申购，包括没中的。中签率只有把没中的算进去才是真的。" />
            </StackPanel>
        </DockPanel>

        <!-- Headline numbers -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="申购次数" Style="{StaticResource KpiCaption}" />
                    <TextBlock x:Name="SubscriptionsText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="中签率（已开奖）" Style="{StaticResource KpiCaption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="HitRateText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="累计已实现收益" Style="{StaticResource KpiCaption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProfitText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="平均每中一签" Style="{StaticResource KpiCaption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AverageText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Entry -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="12"
                Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="记一笔申购" Style="{StaticResource SectionTitle}" />
                <WrapPanel>
                    <ComboBox x:Name="AccountCombo" Width="150" Margin="0,0,8,6"
                              DisplayMemberPath="Name" SelectedValuePath="Id" />
                    <TextBox x:Name="SymbolBox" Width="120" Margin="0,0,8,6" ToolTip="标的，如 SSE:601000" />
                    <TextBox x:Name="NameBox" Width="110" Margin="0,0,8,6" ToolTip="名称（可留空）" />
                    <TextBox x:Name="DateBox" Width="100" Margin="0,0,8,6" ToolTip="申购日 yyyy-MM-dd" />
                    <TextBox x:Name="QuantityBox" Width="90" Margin="0,0,8,6" ToolTip="申购数量" />
                    <TextBox x:Name="PriceBox" Width="90" Margin="0,0,8,6" ToolTip="发行价" />
                    <Button Content="记录申购" Padding="12,4" Margin="0,0,0,6" Click="AddButton_OnClick" />
                </WrapPanel>

                <Separator Margin="0,6" Background="{StaticResource BrushBorder}" />
                <TextBlock Text="更新选中的这一笔" Style="{StaticResource SectionTitle}" />
                <WrapPanel>
                    <TextBox x:Name="AllottedBox" Width="90" Margin="0,0,6,6" ToolTip="中签数量（没中填 0）" />
                    <Button Content="登记开奖结果" Padding="10,4" Margin="0,0,10,6" Click="AllotButton_OnClick" />
                    <TextBox x:Name="PaymentDateBox" Width="100" Margin="0,0,6,6" ToolTip="缴款日 yyyy-MM-dd" />
                    <TextBox x:Name="ListingDateBox" Width="100" Margin="0,0,6,6" ToolTip="上市日 yyyy-MM-dd（可留空）" />
                    <Button Content="登记缴款" Padding="10,4" Margin="0,0,10,6" Click="PayButton_OnClick" />
                    <TextBox x:Name="SoldDateBox" Width="100" Margin="0,0,6,6" ToolTip="卖出日 yyyy-MM-dd" />
                    <TextBox x:Name="SoldPriceBox" Width="90" Margin="0,0,6,6" ToolTip="卖出价" />
                    <TextBox x:Name="SoldFeeBox" Width="80" Margin="0,0,6,6" ToolTip="费用" />
                    <Button Content="登记卖出" Padding="10,4" Margin="0,0,10,6" Click="SellButton_OnClick" />
                    <Button Content="删除" Padding="10,4" Margin="0,0,0,6" Click="DeleteButton_OnClick" />
                </WrapPanel>
                <TextBlock x:Name="EntryStatusText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource BrushFgMuted}"
                           Text="中签后缴款会自动在账本里生成一笔买入，持仓不用重复记。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource BrushBgPanel}" CornerRadius="10"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12">
            <DataGrid x:Name="IpoGrid" Style="{StaticResource WealthGrid}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="申购日" Binding="{Binding SubscribeDate}" Width="100"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="代码" Binding="{Binding Symbol}" Width="120"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="申购/中签" Binding="{Binding QuantityText}" Width="110"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="发行价" Binding="{Binding IssuePriceText}" Width="80"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="卖出价" Binding="{Binding SoldPriceText}" Width="80"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTextColumn Header="上市日" Binding="{Binding ListingDateText}" Width="100"
                                        ElementStyle="{StaticResource WealthCellText}" />
                    <DataGridTemplateColumn Header="收益" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProfitText}" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushFgMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGain}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
