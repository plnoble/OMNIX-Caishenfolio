<Window x:Class="Caishenfolio.Desktop.Wealth.PortfolioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="理财偏好设置"
        Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BrushBgApp}"
        Foreground="{StaticResource BrushFgPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Base currency -->
                <TextBlock Text="本位币" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="所有账户的资产会折算成这个货币汇总。改变它会新开一条估值曲线（历史按货币分开保存）。"
                           TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}" FontSize="12" Margin="0,0,0,6" />
                <ComboBox x:Name="BaseCurrencyCombo" Width="120" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <ComboBoxItem Content="CNY" />
                    <ComboBoxItem Content="HKD" />
                    <ComboBoxItem Content="USD" />
                    <ComboBoxItem Content="JPY" />
                </ComboBox>

                <!-- Thresholds -->
                <TextBlock Text="集中度上限" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="超过这些比例时会在总览页提醒。这些是你自己的偏好，不是投资建议。"
                           TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}" FontSize="12" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="单一持仓" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="SinglePositionBox" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="%  单个标的占总资产" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushFgMuted}" Margin="6,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="单一品种" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AssetClassBox" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="%  股票 / ETF / 债券 等" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushFgMuted}" Margin="6,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="单一市场" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="RegionBox" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="%  A股 / 港股 / 美股 / 日股" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushFgMuted}" Margin="6,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="单一货币" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="CurrencyBox" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="%  含该货币的现金与持仓" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushFgMuted}" Margin="6,4" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="现金" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="CashBox" Margin="0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="%  闲置现金占比" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushFgMuted}" Margin="6,4" />
                </Grid>

                <!-- Price cross-check -->
                <TextBlock Text="取价方式" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="CrossCheckBox" Content="向多个数据源交叉核对价格（取中位数）"
                          Foreground="{StaticResource BrushFgPrimary}" Margin="0,0,0,6" />
                <TextBlock Text="关闭时只用第一个应答的数据源，快但一个错价会静默算错市值。开启后取价请求变多、刷新变慢。"
                           TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}" FontSize="12" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <TextBlock Text="价格容差" VerticalAlignment="Center" Width="130" />
                    <TextBox x:Name="PriceToleranceBox" Width="90" />
                    <TextBlock Text="%  各源相差超过此值就提醒" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushFgMuted}" Margin="6,0" />
                </StackPanel>

                <!-- Target allocation -->
                <TextBlock Text="目标配置" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="填写你自己的目标比例，总览页会算出与当前配置的差额金额。要么全部留空，要么合计正好 100%。"
                           TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}" FontSize="12" Margin="0,0,0,8" />
                <ItemsControl x:Name="TargetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TargetBox_OnTextChanged" />
                                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushFgMuted}" Margin="6,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TargetTotalText" Margin="0,8,0,18" FontWeight="SemiBold" Text="合计 0%" />

                <!-- Notifications -->
                <TextBlock Text="通知推送（软件关着也能收到）" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}" FontSize="12"
                           Margin="0,0,0,8">
                    打新中签后必须在规定日期前缴款，逾期作废，一年内三次还会被暂停申购半年。
                    这类时限不会等你打开软件，所以可以让它推到手机上。<LineBreak />
                    机器人地址和邮箱密码属于凭据，保存时会用 Windows 账户加密后再写入账本文件。
                </TextBlock>

                <!-- Capability statement: what the background run does and, just as important,
                     what it does not do. Kept in code-behind because it changes with the
                     extended-check switch below. -->
                <Border Background="#121A24" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <TextBlock x:Name="BackgroundScopeText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource BrushFgSecondary}" />
                </Border>

                <CheckBox x:Name="NotifyEnabledBox" Content="启用通知推送" Margin="0,0,0,8" />

                <!-- Configured channels. Several can be on at once; each is tried independently. -->
                <DataGrid x:Name="ChannelGrid" Style="{StaticResource WealthGrid}" MaxHeight="140"
                          Margin="0,0,0,8" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50" />
                        <DataGridTextColumn Header="渠道" Binding="{Binding FlavorName}" Width="110"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="地址 / Token（已隐藏）" Binding="{Binding MaskedSecret}"
                                            Width="*" IsReadOnly="True"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="Chat ID" Binding="{Binding ChatId}" Width="90"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource WealthCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="删除选中渠道" Padding="10,3" Click="RemoveChannelButton_OnClick" />
                    <TextBlock Text="勾选「启用」可临时停用某个渠道而不删除它。" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                </StackPanel>

                <TextBlock Text="添加渠道" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{StaticResource BrushFgSecondary}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="NotifyFlavorCombo" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="NotifyWebhookBox" Margin="0,0,8,0"
                             ToolTip="群机器人 Webhook 地址；Telegram 填 Bot Token" />
                    <TextBox Grid.Column="2" x:Name="NotifyChatIdBox" Margin="0,0,8,0"
                             ToolTip="仅 Telegram 需要；其他渠道留空" />
                    <Button Grid.Column="3" Content="添加" Padding="14,4" Click="AddChannelButton_OnClick" />
                </Grid>

                <CheckBox x:Name="NotifyRoutineBox"
                          Content="软件打开时也推送价格与集中度提醒（关掉则只推有时限的事项）"
                          Margin="0,0,0,6" />
                <TextBlock Text="勾选与否不影响后台检查的内容。"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource BrushFgMuted}" Margin="0,0,0,10" />

                <!-- Layer 2: networked checks behind the deadline layer (plan §8). -->
                <CheckBox x:Name="BackgroundExtendedBox"
                           Content="后台扩展检查：软件关闭时也查价格与集中度"
                           Margin="0,0,0,4"
                           Checked="BackgroundExtendedBox_OnChanged" Unchecked="BackgroundExtendedBox_OnChanged" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushFgMuted}"
                           Margin="0,0,0,6"
                           Text="会临时启动分析核心（较慢，首次可能要装依赖）。规则、阈值与打开软件时完全一致；启动或取价失败只记录原因，打新时限提醒不受影响。" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="同一提醒的冷却时间" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                    <TextBox x:Name="AlertCooldownBox" Width="52" Padding="4" Margin="0,0,6,0"
                             ToolTip="冷却期内同一事项不重复推送；条件消失后再次触发（重新进入区间）会立即重新推送。默认 20 小时 ≈ 每日任务每天最多提醒一次。" />
                    <TextBlock Text="小时" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource BrushFgMuted}" />
                </StackPanel>

                <!-- N2.4: user-defined FX watch rules. Facts-only wording by construction. -->
                <TextBlock Text="换汇提醒规则" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{StaticResource BrushFgSecondary}" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushFgMuted}"
                           Margin="0,0,0,6"
                           Text="提醒只陈述「你设定的事实被触发」（如汇率进入区间、已持有路径优势达到阈值），不会说现在是换汇的好时机。优势为毛额口径，未计点差与手续费；需要账本里有该外币的持仓成本（先在「账本」页录入换汇）。" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ComboBox x:Name="FxRuleKindCombo" Width="110" Margin="0,0,8,0" SelectedIndex="0"
                              SelectionChanged="FxRuleKind_OnSelectionChanged">
                        <ComboBoxItem Tag="RateBand" Content="汇率进入区间" />
                        <ComboBoxItem Tag="HeldAdvantageAbove" Content="路径优势达阈值" />
                        <ComboBoxItem Tag="NetArrivalAbove" Content="净到账达目标" />
                        <ComboBoxItem Tag="BreakevenCrossed" Content="越过盈亏平衡" />
                    </ComboBox>
                    <!-- RateBand inputs -->
                    <StackPanel x:Name="FxRuleBandPanel" Orientation="Horizontal">
                        <TextBox x:Name="FxRulePairBox" Width="86" Padding="4" Margin="0,0,6,0"
                                 ToolTip="货币对，如 USD/CNY（1 USD = x CNY）" />
                        <TextBox x:Name="FxRuleLowerBox" Width="70" Padding="4" Margin="0,0,6,0"
                                 ToolTip="区间下限（留空 = 无下限）" />
                        <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource BrushFgMuted}" />
                        <TextBox x:Name="FxRuleUpperBox" Width="70" Padding="4" Margin="0,0,6,0"
                                 ToolTip="区间上限（留空 = 无上限）" />
                    </StackPanel>
                    <!-- Path-rule inputs: one base/held/target triple shared by all three kinds -->
                    <StackPanel x:Name="FxRulePathPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <ComboBox x:Name="FxRuleBaseCombo" Width="60" Margin="0,0,4,0" SelectedIndex="0">
                            <ComboBoxItem Content="CNY" /><ComboBoxItem Content="HKD" />
                            <ComboBoxItem Content="USD" /><ComboBoxItem Content="JPY" />
                        </ComboBox>
                        <TextBlock Text="持" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                        <ComboBox x:Name="FxRuleHeldCombo" Width="60" Margin="0,0,4,0" SelectedIndex="2">
                            <ComboBoxItem Content="CNY" /><ComboBoxItem Content="HKD" />
                            <ComboBoxItem Content="USD" /><ComboBoxItem Content="JPY" />
                        </ComboBox>
                        <TextBlock Text="换" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                        <ComboBox x:Name="FxRuleTargetCombo" Width="60" Margin="0,0,6,0" SelectedIndex="2">
                            <ComboBoxItem Content="CNY" /><ComboBoxItem Content="HKD" />
                            <ComboBoxItem Content="USD" /><ComboBoxItem Content="JPY" />
                        </ComboBox>
                        <StackPanel x:Name="FxRuleThresholdPanel" Orientation="Horizontal">
                            <TextBlock x:Name="FxRuleThresholdLabel" Text="优势≥" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                            <TextBox x:Name="FxRuleThresholdBox" Width="52" Padding="4" Margin="0,0,3,0"
                                     ToolTip="阈值（百分比），如 3 表示 +3%" />
                            <TextBlock x:Name="FxRuleThresholdUnit" Text="%" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                        </StackPanel>
                        <!-- P1-06: net-arrival rules need the cost model they are evaluated against;
                             without it the rule is reported as not evaluated, never priced as free. -->
                        <StackPanel x:Name="FxRuleCostPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="点差" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                            <TextBox x:Name="FxRuleSpreadBox" Width="44" Padding="4" Margin="0,0,3,0"
                                     ToolTip="比例成本（点差等，百分比）。必须填写：填 0 表示确认无点差；留空=未知，规则不评估" />
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                            <TextBlock Text="固定费" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{StaticResource BrushFgMuted}" FontSize="11" />
                            <TextBox x:Name="FxRuleFixedFeeBox" Width="56" Padding="4" Margin="0,0,3,0"
                                     ToolTip="每次兑换的固定手续费（目标货币金额）。必须填写：填 0 表示确认无固定费；留空=未知" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="添加规则" Padding="10,3" Margin="8,0,0,0" Click="AddFxRuleButton_OnClick" />
                </StackPanel>
                <DataGrid x:Name="FxRuleGrid" Style="{StaticResource WealthGrid}" MaxHeight="110"
                          Margin="0,0,0,6" IsReadOnly="False" AutoGenerateColumns="False"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" Width="110" IsReadOnly="True"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="内容" Binding="{Binding Describe}" Width="*" IsReadOnly="True"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="46" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="删除选中规则" Padding="10,3" Click="RemoveFxRuleButton_OnClick" />
                    <TextBlock Text="「启用」列可直接勾选/取消勾选；删除后点「保存」生效。"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               Foreground="{StaticResource BrushFgMuted}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="发送测试通知" Padding="12,4" Margin="0,0,8,0"
                            Click="TestNotifyButton_OnClick" />
                    <Button x:Name="ScheduleButton" Content="注册每日后台检查" Padding="12,4" Margin="0,0,8,0"
                            Click="ScheduleButton_OnClick"
                            ToolTip="注册 Windows 计划任务，每天在设定时间运行一次后台检查（范围见上方说明）" />
                    <Button Content="取消后台检查" Padding="12,4" Click="UnscheduleButton_OnClick" />
                </StackPanel>
                <!-- Last run: the proof the background check actually fired, and what it found. -->
                <TextBlock x:Name="BackgroundCheckText" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource BrushFgMuted}" Margin="0,0,0,4" />
                <TextBlock x:Name="NotifyStatusText" TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}"
                           FontSize="12" Margin="0,0,0,18" />

                <!-- Legacy import -->
                <TextBlock Text="导入旧版成交台账" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="把 P4.3 时期记在「计划」页的真实成交搬进账本。可重复点击，已导入的不会重复。"
                           TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}" FontSize="12" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="LegacyAccountCombo" Width="180" Margin="0,0,8,0"
                              DisplayMemberPath="Name" SelectedValuePath="Id" />
                    <Button Content="导入到该账户" Padding="12,4" Click="ImportLegacyButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="LegacyStatusText" TextWrapping="Wrap" Foreground="{StaticResource BrushFgMuted}"
                           FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消" Padding="16,6" Margin="0,0,8,0" Click="CancelButton_OnClick" />
                <Button Content="保存" Padding="16,6" Click="SaveButton_OnClick"
                        Background="#1F6B4A" BorderBrush="#2F9A6A" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushDanger}" />
        </DockPanel>
    </Grid>
</Window>
