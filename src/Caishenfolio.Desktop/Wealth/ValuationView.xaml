<UserControl x:Class="Caishenfolio.Desktop.Wealth.ValuationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="标的" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource BrushFgMuted}" />
                <TextBox x:Name="SymbolBox" Width="130" Margin="0,0,8,0" Text="SSE:600000" />
                <TextBlock Text="回溯" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource BrushFgMuted}" />
                <ComboBox x:Name="YearsCombo" Width="76" Margin="0,0,8,0" SelectedIndex="2">
                    <ComboBoxItem Tag="3" Content="3 年" />
                    <ComboBoxItem Tag="5" Content="5 年" />
                    <ComboBoxItem Tag="10" Content="10 年" IsSelected="True" />
                </ComboBox>
                <Button x:Name="LoadButton" Content="查看" Padding="14,6" Click="LoadButton_OnClick" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="估值位置" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" />
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushFgMuted}"
                           Text="输入标的后点「查看」。这里回答的是「现在贵不贵」——相对它自己的历史。" />
            </StackPanel>
        </DockPanel>

        <!-- What this page is for, in plain language -->
        <Border Grid.Row="1" Background="#16202B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="怎么读这一页" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"
                           Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushFgSecondary}" FontSize="12">
                    「分位」是把今天的估值放回它自己过去若干年里排名。8% 分位＝过去只有 8% 的时间比现在更便宜。<LineBreak />
                    每项下面的「历史上出现过 N 次可比情形」是关键：它告诉你从类似位置出发，过去实际发生了什么，
                    <Run FontWeight="SemiBold" Foreground="{StaticResource BrushDanger}">包括最差的那次</Run>。
                    样本太少时会直接说不具统计意义，而不是硬给一个数。<LineBreak />
                    这些都是历史统计，不是预测，也不是买卖依据。
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ReadingList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14"
                                Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <!-- Headline: value, percentile, band -->
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="10,4"
                                            Background="{Binding BandBrush}">
                                        <TextBlock Text="{Binding BandLabel}" FontWeight="SemiBold"
                                                   Foreground="#0B1018" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentText}" FontSize="15" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushAccent}" />
                                        <TextBlock Text="{Binding PercentileText}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushFgMuted}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Where it sits, as a bar -->
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentileValue, Mode=OneWay}"
                                             Height="8" Margin="0,0,0,10" Background="#0A0F16"
                                             Foreground="{Binding BandBrush}"
                                             BorderBrush="{StaticResource BrushBorder}" />

                                <TextBlock Text="{Binding BandDescription}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource BrushFgSecondary}" Margin="0,0,0,8" />

                                <!-- Education -->
                                <TextBlock Text="{Binding WhatItIs}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource BrushFgSecondary}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding HowToRead}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource BrushFgSecondary}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding Caveat}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource BrushDanger}" Margin="0,0,0,8" />

                                <!-- What happened next, historically -->
                                <TextBlock Text="从类似位置出发，历史上后来发生了什么"
                                           FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4"
                                           Foreground="{StaticResource BrushAccent}" />
                                <ItemsControl ItemsSource="{Binding Outcomes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource BrushFgPrimary}"
                                                       Margin="0,0,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource BrushFgMuted}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
