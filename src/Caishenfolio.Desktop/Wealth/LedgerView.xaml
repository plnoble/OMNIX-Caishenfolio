<UserControl x:Class="Caishenfolio.Desktop.Wealth.LedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="NewRecordButton" Content="新增记录" Padding="14,6" Margin="0,0,8,0"
                        Background="#1F6B4A" BorderBrush="#2F9A6A" Click="NewRecordButton_OnClick"
                        ToolTip="投入 / 转出 / 转到我的另一个账户 / 当天资产金额。只填日期、操作、金额、备注。" />
                <Button x:Name="ExportButton" Content="导出流水" Padding="12,6" Margin="0,0,8,0"
                        Click="ExportButton_OnClick" />
                <Button x:Name="RefreshButton" Content="刷新" Padding="12,6" Click="RefreshButton_OnClick" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="账本" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" />
                <TextBlock x:Name="StatusText" Text="先建账户，再录入或导入交易。" Margin="0,4,0,0"
                           Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Accounts + entry + import -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" CornerRadius="10" Margin="0,0,10,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="账户" Style="{StaticResource SectionTitle}" />
                    <DataGrid x:Name="AccountsGrid" Style="{StaticResource WealthGrid}" Height="120"
                              SelectionMode="Single" SelectionChanged="AccountsGrid_OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"
                                                ElementStyle="{StaticResource WealthCellText}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70"
                                                ElementStyle="{StaticResource WealthCellText}" />
                            <DataGridTextColumn Header="现金" Binding="{Binding Cash}" Width="130"
                                                ElementStyle="{StaticResource WealthCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBox x:Name="NewAccountName" Width="110" Margin="0,0,6,6" ToolTip="账户名称，如 华泰证券" />
                        <ComboBox x:Name="NewAccountKind" Width="86" Margin="0,0,6,6" SelectedIndex="0">
                            <ComboBoxItem Tag="Securities" Content="证券" IsSelected="True" />
                            <ComboBoxItem Tag="FundPlatform" Content="基金平台" />
                            <ComboBoxItem Tag="Bank" Content="银行" />
                            <ComboBoxItem Tag="Cash" Content="现金" />
                            <ComboBoxItem Tag="Other" Content="其他" />
                        </ComboBox>
                        <ComboBox x:Name="NewAccountCurrency" Width="70" Margin="0,0,6,6" SelectedIndex="0">
                            <ComboBoxItem Content="CNY" IsSelected="True" />
                            <ComboBoxItem Content="HKD" />
                            <ComboBoxItem Content="USD" />
                            <ComboBoxItem Content="JPY" />
                        </ComboBox>
                        <Button Content="新建账户" Padding="10,4" Margin="0,0,0,6" Click="AddAccountButton_OnClick" />
                    </WrapPanel>
                    <CheckBox x:Name="NewAccountBalanceMode" Content="余额模式（只报当天资产金额）"
                              Foreground="{StaticResource BrushFgPrimary}" FontSize="12" Margin="0,0,0,0"
                              ToolTip="余额模式：这个账户只记投入/转出，市值由你报的「当天资产金额」决定，不按持仓算。明细模式：按交易记账，市值由现金+持仓算出。" />
                </StackPanel>
            </Border>

            <!-- Manual entry + import -->
            <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}" CornerRadius="10"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="记一笔" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="EntryGuideText" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                               Foreground="{StaticResource BrushFgSecondary}"
                               Text="银行存钱选「入金」，只填金额和币种。买股票才填代码、数量和价格。换汇选「换汇」，填写换出和换入两边金额。" />
                    <WrapPanel>
                        <StackPanel Width="116" Margin="0,0,8,6">
                            <TextBlock Text="日期" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryDate" />
                        </StackPanel>
                        <StackPanel Width="116" Margin="0,0,8,6">
                            <TextBlock Text="类型" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                        <ComboBox x:Name="EntryKind" SelectedIndex="0"
                                  SelectionChanged="EntryKind_OnSelectionChanged">
                            <ComboBoxItem Tag="Buy" Content="买入" IsSelected="True" />
                            <ComboBoxItem Tag="Sell" Content="卖出" />
                            <ComboBoxItem Tag="Dividend" Content="分红" />
                            <ComboBoxItem Tag="Interest" Content="利息" />
                            <ComboBoxItem Tag="Deposit" Content="入金" />
                            <ComboBoxItem Tag="Withdraw" Content="出金" />
                            <ComboBoxItem Tag="OpeningPosition" Content="期初持仓" />
                            <ComboBoxItem Tag="OpeningCash" Content="期初现金" />
                            <ComboBoxItem Tag="FxExchange" Content="换汇" />
                        </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="EntrySymbolField" Width="116" Margin="0,0,8,6">
                            <TextBlock Text="代码或名称" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntrySymbol" TextChanged="EntrySymbol_OnTextChanged"
                                     ToolTip="股票、基金才填写。银行存取款不需要代码。" />
                        </StackPanel>
                        <StackPanel x:Name="EntryNameField" Width="116" Margin="0,0,8,6">
                            <TextBlock Text="名称" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryName" ToolTip="可留空" />
                        </StackPanel>
                        <StackPanel x:Name="EntryQuantityField" Width="116" Margin="0,0,8,6">
                            <TextBlock Text="数量" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryQuantity" ToolTip="股票股数或基金份额" />
                        </StackPanel>
                        <StackPanel x:Name="EntryPriceField" Width="116" Margin="0,0,8,6">
                            <TextBlock Text="价格" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryPrice" ToolTip="每股价格或基金净值" />
                        </StackPanel>
                        <StackPanel x:Name="EntryAmountField" Width="116" Margin="0,0,8,6">
                            <TextBlock Text="金额" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryAmount" TextChanged="FxField_OnChanged"
                                     ToolTip="银行存取款填写这里。买入股票时可留空，由数量乘价格计算。" />
                        </StackPanel>
                        <StackPanel x:Name="EntryCounterAmountField" Width="116" Margin="0,0,8,6">
                            <TextBlock Text="换入金额" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryCounterAmount" TextChanged="FxField_OnChanged" IsEnabled="False"
                                 ToolTip="换汇：回单上的实际到账金额（换入币种）。不要用汇率反推——两边金额按回单如实填写。" />
                        </StackPanel>
                        <StackPanel x:Name="EntryCounterAccountField" Width="140" Margin="0,0,8,6">
                            <TextBlock Text="换入账户" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                        <ComboBox x:Name="EntryCounterAccount" IsEnabled="False"
                                  ToolTip="换汇：到账账户。默认同一账户；跨账户时选到账账户（如银行换美元入券商）" />
                        </StackPanel>
                        <StackPanel x:Name="EntryCounterCurrencyField" Width="116" Margin="0,0,8,6">
                            <TextBlock Text="换入币种" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                        <ComboBox x:Name="EntryCounterCurrency" SelectedIndex="1"
                                  SelectionChanged="FxField_OnChanged" IsEnabled="False"
                                  ToolTip="换汇：换入的货币">
                            <ComboBoxItem Content="CNY" />
                            <ComboBoxItem Content="HKD" IsSelected="True" />
                            <ComboBoxItem Content="USD" />
                            <ComboBoxItem Content="JPY" />
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Width="116" Margin="0,0,8,6">
                            <TextBlock x:Name="EntryCurrencyLabel" Text="币种" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                        <ComboBox x:Name="EntryCurrency" SelectedIndex="0"
                                  SelectionChanged="FxField_OnChanged">
                            <ComboBoxItem Content="CNY" IsSelected="True" />
                            <ComboBoxItem Content="HKD" />
                            <ComboBoxItem Content="USD" />
                            <ComboBoxItem Content="JPY" />
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Width="116" Margin="0,0,8,6">
                            <TextBlock Text="手续费" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryFee" ToolTip="没有就留空" />
                        </StackPanel>
                        <StackPanel Width="116" Margin="0,0,8,6">
                            <TextBlock Text="税费" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryTax" ToolTip="没有就留空" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,8,6">
                            <TextBlock Text="备注" FontSize="11" Foreground="{StaticResource BrushFgMuted}" />
                            <TextBox x:Name="EntryNote" ToolTip="可留空" />
                        </StackPanel>
                        <Button Content="记账" Padding="14,4" Margin="0,0,0,6" Click="RecordButton_OnClick" />
                    </WrapPanel>
                    <TextBlock x:Name="EntrySymbolHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                               Foreground="{StaticResource BrushFgSecondary}" Text="" />
                    <TextBlock x:Name="FxRateHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                               Foreground="{StaticResource BrushAccent}" Text="" Visibility="Collapsed" />

                    <Separator Margin="0,6" Background="{StaticResource BrushBorder}" />

                    <TextBlock Text="从 CSV 导入" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Content="选择 CSV 文件…" Padding="12,4" Margin="0,0,8,6" Click="ChooseFileButton_OnClick" />
                        <Button Content="保存导入模板…" Padding="12,4" Margin="0,0,8,6" Click="SaveTemplateButton_OnClick" />
                        <CheckBox x:Name="SkipInvalidCheck" Content="跳过错误行" VerticalAlignment="Center"
                                  Foreground="{StaticResource BrushFgSecondary}" Margin="0,0,8,6" />
                        <Button x:Name="CommitImportButton" Content="确认导入" Padding="12,4" Margin="0,0,8,6"
                                IsEnabled="False" Click="CommitImportButton_OnClick" />
                    </WrapPanel>
                    <TextBlock x:Name="ImportStatusText" Text="导入前会先预览校验，确认无误再写入账本。"
                               Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Account summary: what each account is worth and what it earned -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" CornerRadius="10"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="账户汇总" Style="{StaticResource SectionTitle}" />
                <DataGrid Grid.Row="1" x:Name="AccountSummaryGrid" Style="{StaticResource WealthGrid}" Height="120"
                          SelectionMode="Single" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="账户" Binding="{Binding Name}" Width="150"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="总资产" Binding="{Binding TotalValue}" Width="140"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="累计收益（总资产−净投入）" Binding="{Binding CumulativePnl}" Width="180"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="资金加权收益率" Binding="{Binding MoneyWeightedReturn}" Width="130"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="年化" Binding="{Binding Annualized}" Width="100"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*"
                                            ElementStyle="{StaticResource WealthCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Transactions -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgPanel}" CornerRadius="10"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Left" Content="撤销这笔" Padding="10,3" Margin="0,0,8,8"
                            Click="ReverseTransactionButton_OnClick"
                            ToolTip="保留原流水，新增一条反向冲正记录。现金、持仓与收益会回到记账前，历史不可抵赖。" />
                    <TextBlock DockPanel.Dock="Left" Text="记错了选中该行，点「撤销这笔」。原记录保留，同时新增一笔相反记录。" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushFgMuted}" FontSize="11" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Left" Text="交易流水" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="TransactionsGrid" Style="{StaticResource WealthGrid}" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="100"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="账户" Binding="{Binding Account}" Width="120"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="标的" Binding="{Binding Symbol}" Width="120"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="90"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="价格" Binding="{Binding Price}" Width="90"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="60"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="费税" Binding="{Binding Fee}" Width="80"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="金额" Binding="{Binding Amount}" Width="100"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTemplateColumn Header="状态" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="已入账" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushFgMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReversal}" Value="True">
                                                        <Setter Property="Text" Value="冲正" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                        <Setter Property="Text" Value="已冲正" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
