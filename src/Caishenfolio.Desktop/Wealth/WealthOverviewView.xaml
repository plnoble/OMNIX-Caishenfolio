<UserControl x:Class="Caishenfolio.Desktop.Wealth.WealthOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="刷新估值" Padding="14,6"
                    Click="RefreshButton_OnClick" />
            <StackPanel>
                <TextBlock Text="资产总览" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" />
                <TextBlock x:Name="StatusText" Text="尚未加载账本。" Margin="0,4,0,0"
                           Foreground="{StaticResource BrushFgMuted}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- KPI tiles -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="总资产" Style="{StaticResource KpiCaption}" />
                    <TextBlock x:Name="TotalValueText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="累计盈亏（含已实现与分红）" Style="{StaticResource KpiCaption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TotalPnlText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="持仓成本" Style="{StaticResource KpiCaption}" />
                    <TextBlock x:Name="CostText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="现金" Style="{StaticResource KpiCaption}" />
                    <TextBlock x:Name="CashText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushBgPanel}" CornerRadius="10" Padding="14,12"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="资金年化收益 XIRR" Style="{StaticResource KpiCaption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="XirrText" Text="—" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Incomplete-valuation banner -->
        <Border Grid.Row="2" x:Name="WarningBanner" Visibility="Collapsed" Margin="0,0,0,12"
                Background="#3A2A20" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1"
                CornerRadius="8" Padding="12,10">
            <StackPanel>
                <TextBlock Text="估值不完整 —— 以下项目未计入合计（不会按 0 计算）"
                           Foreground="{StaticResource BrushDanger}" FontWeight="SemiBold" />
                <ItemsControl x:Name="WarningList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource BrushFgSecondary}"
                                       TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Allocation -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgPanel}" CornerRadius="10"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left" Text="资产配置" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="AsOfText" DockPanel.Dock="Right" Text="—" HorizontalAlignment="Right"
                               Foreground="{StaticResource BrushFgMuted}" FontSize="12" />
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="AllocationGrid" Style="{StaticResource WealthGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="维度" Binding="{Binding Dimension}" Width="80"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="分类" Binding="{Binding Label}" Width="150"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="市值" Binding="{Binding Value}" Width="140"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTextColumn Header="占比" Binding="{Binding Weight}" Width="80"
                                            ElementStyle="{StaticResource WealthCellText}" />
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding WeightFraction, Mode=OneWay}"
                                                 Height="10" Margin="6,0" Background="#0A0F16"
                                                 Foreground="{StaticResource BrushAccent}"
                                                 BorderBrush="{StaticResource BrushBorder}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
